# StockAI — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git (it is already in .gitignore).
#
# HOW TO GET THESE VALUES
# ────────────────────────
# 1. Go to https://supabase.com/dashboard
# 2. Create a new project (or open an existing one)
# 3. Navigate to Project Settings → API
# 4. Copy "Project URL" → VITE_SUPABASE_URL
# 5. Copy "Project API Keys" → anon / public → VITE_SUPABASE_PUBLISHABLE_KEY
#
# REQUIRED DATABASE TABLES
# ─────────────────────────
# After creating your Supabase project, run the SQL in:
#   supabase/migrations/20250101000000_initial_schema.sql
# via the Supabase Dashboard → SQL Editor.
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL  (e.g. https://abcdefghijkl.supabase.co)
VITE_SUPABASE_URL= 

# Your Supabase anon/public key  (the long JWT starting with "eyJ...")
VITE_SUPABASE_PUBLISHABLE_KEY= 
# Optional — used by supabase CLI and edge functions
VITE_SUPABASE_PROJECT_ID= 

# Edge function API keys (set these as Supabase project secrets, not here)
# FINANCIAL_MODELING_PREP_API_KEY=your_fmp_key_here
# GEMINI_API_KEY=your_gemini_key_here
